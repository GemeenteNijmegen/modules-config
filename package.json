    "@types/node": "^24.13.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk-lib": "2.233.0",
    "commit-and-tag-version": "^12",
    "constructs": "10.5.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "jest-junit": "^17",
    "jsii": "~5.9.0",
    "jsii-diff": "^1.134.0",
    "jsii-docgen": "^10.5.0",
    "jsii-pacmak": "^1.134.0",
    "jsii-rosetta": "~5.9.0",
